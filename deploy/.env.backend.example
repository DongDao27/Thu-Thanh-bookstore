# D105 production TEMPLATE. Fill only in private shared/backend/.env on VPS.
APP_NAME="Thu Thanh"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.books.example.com
FRONTEND_URL=https://books.example.com
APP_TIMEZONE=UTC
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=thu_thanh
DB_USERNAME=thu_thanh
DB_PASSWORD=
DB_SSLMODE=prefer
HASH_DRIVER=argon2id
SESSION_DRIVER=database
# Host-only cookie for Vercel same-origin rewrites. Do not set api.books.example.com.
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_LIFETIME=120
SANCTUM_STATEFUL_DOMAINS=books.example.com
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public
MAIL_MAILER=resend
MAIL_FROM_ADDRESS=notifications@books.example.com
MAIL_FROM_NAME="Nhà sách Thu Thanh"
RESEND_API_KEY=
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap1
LOG_CHANNEL=daily
LOG_LEVEL=warning
TELESCOPE_ENABLED=false
OPS_MONITORING_ENABLED=true
OPS_ALERT_EMAIL=
STORE_DELIVERY_FEE_VND=25000
STORE_REVENUE_POLICY=approved_v1
VNPAY_ENV=sandbox
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=https://books.example.com/payment/vnpay-return
VNPAY_IPN_URL=https://api.books.example.com/api/v1/payments/vnpay/ipn
VNPAY_QR_CAPABILITY_VERIFIED=false
VNPAY_DEFERRED=true
# Nginx sets verified client IP and HTTPS directly. Never set '*' here.
TRUSTED_PROXIES=
